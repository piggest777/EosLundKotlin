<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- When button is selected, show a white line at the bottom -->
    <item android:state_selected="true">
        <layer-list>
            <item android:top="-3dp" android:left="-3dp" android:right="-3dp">
                <shape android:shape="rectangle">
                    <solid android:color="@android:color/transparent" />
                    <stroke android:width="2dp" android:color="@android:color/white" android:gravity="bottom" />
                </shape>
            </item>
        </layer-list>
    </item>

    <!-- Default state (no underline) -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
</selector>

