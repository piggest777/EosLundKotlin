<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="se.eoslund.piggest">

    <application
        android:name=".controller.App"
        android:allowBackup="true"
        android:icon="@mipmap/ic_eos_logo"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_eos_logo_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.EosLund">

        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/eos_logo" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/colorSecondary" />

        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="@string/default_notification_channel_id" />

        <activity
            android:name=".controller.MatchListActivity"
            android:exported="false" />
        <activity
            android:name=".controller.YoutubePlayerFullScreen"
            android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|uiMode|screenSize|smallestScreenSize"
            android:exported="false"
            android:windowSoftInputMode="adjustPan" />
        <activity
            android:name=".controller.PlayerActivity"
            android:exported="false" />
        <activity
            android:name=".controller.MatchActivity"
            android:exported="false" />
        <activity
            android:name=".controller.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.App.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".services.FirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <meta-data
            android:name="preloaded_fonts"
            android:resource="@array/preloaded_fonts" />
    </application>

</manifest>